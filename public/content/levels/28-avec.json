 "insights": [
  {
   "by": "anna",
   "fr": [
    "Nouvelle couleur : le violet foncé ! Après « с » (avec), le mot prend -ом ou -ой / -ей : « с молоком », « с сахаром », « с Машей ».",
    "Masculin et neutre : -ом. Féminin : -ой (ou -ей)."
   ]
  },
  {
   "by": "anna",
   "fr": [
    "Et le contraire, « без » (sans), prend l'orange, comme « нет » : « без сахара », « без молока ».",
    "« С » (avec) = violet, « без » (sans) = orange. Avec ou sans, tu sais tout dire !"
   ]
  }
 ],
