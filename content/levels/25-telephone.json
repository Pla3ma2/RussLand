  "titleFr": "Au téléphone",
  "titleRu": "По телефону",
  "emoji": "📞",
  "sceneFr": "Fin janvier, c'est bientôt l'anniversaire de Luka. Il appelle Anna pour l'inviter.",
  "dialogue": [
    {
      "speaker": "luka",
      "ru": "Алло, +Анна? Это Л+ука.",
      "fr": "Allô, Anna ? C'est Luka."
    },
    {
      "speaker": "anna",
      "ru": "Привет, Л+ука! Как дела?",
      "fr": "Salut, Luka ! Comment ça va ?"
    },
    {
      "speaker": "luka",
      "ru": "Хорошо, спасибо! В субботу у меня день рождения.",
      "fr": "Bien, merci ! Samedi, c'est mon anniversaire."
    },
    {
      "speaker": "luka",
      "ru": "Приходи ко мне!",
      "fr": "Viens chez moi !"
    },
    {
      "speaker": "anna",
      "ru": "С удовольствием! Во сколько?",
      "fr": "Avec plaisir ! À quelle heure ?"
    },
    {
      "speaker": "luka",
      "ru": "В шесть часов.",
      "fr": "À six heures."
    },
    {
      "speaker": "anna",
      "ru": "Отлично, я приду. Что тебе подарить?",
      "fr": "Parfait, je viendrai. Qu'est-ce que je peux t'offrir ?"
    },
    {
      "speaker": "luka",
      "ru": "Ничего не надо! Просто приходи.",
      "fr": "Rien du tout ! Viens, c'est tout."
    }
  ],
