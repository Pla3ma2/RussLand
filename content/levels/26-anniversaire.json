  "titleFr": "Joyeux anniversaire !",
  "titleRu": "С днём рождения!",
  "emoji": "🎂",
  "sceneFr": "Samedi, six heures. Les amis arrivent chez Luka pour son anniversaire.",
  "dialogue": [
    {
      "speaker": "anna",
      "ru": "С днём рождения, Л+ука!",
      "fr": "Joyeux anniversaire, Luka !"
    },
    {
      "speaker": "luka",
      "ru": "Спасибо! Проходи!",
      "fr": "Merci ! Entre !"
    },
    {
      "speaker": "anna",
      "ru": "Это тебе подарок.",
      "fr": "C'est un cadeau pour toi."
    },
    {
      "speaker": "luka",
      "ru": "Какой красивый шарф! Спасибо!",
      "fr": "Quelle belle écharpe ! Merci !"
    },
    {
      "speaker": "oleg",
      "ru": "Л+ука, сколько тебе лет?",
      "fr": "Luka, quel âge as-tu ?"
    },
    {
      "speaker": "luka",
      "ru": "Мне двадцать пять лет.",
      "fr": "J'ai vingt-cinq ans."
    },
    {
      "speaker": "masha",
      "ru": "А мне тридцать. Я старше!",
      "fr": "Et moi, trente. Je suis plus âgée !"
    },
    {
      "speaker": "oleg",
      "ru": "Желаю тебе счастья и здоровья!",
      "fr": "Je te souhaite du bonheur et la santé !"
    }
  ],
