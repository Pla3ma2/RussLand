  "emoji": "☕",
  "sceneFr": "Le lendemain de la fête, Luka passe au café. Anna lui sert un café… et lui pose des questions sur Macha.",
  "dialogue": [
    {
      "speaker": "anna",
      "ru": "Привет, Л+ука! Тебе кофе?",
      "fr": "Salut, Luka ! Un café pour toi ?"
    },
    {
      "speaker": "luka",
      "ru": "Да, кофе с молоком, пожалуйста.",
      "fr": "Oui, un café au lait, s'il te plaît."
    },
    {
      "speaker": "anna",
      "ru": "С сахаром?",
      "fr": "Avec du sucre ?"
    },
    {
      "speaker": "luka",
      "ru": "Нет, без сахара.",
      "fr": "Non, sans sucre."
    },
    {
      "speaker": "anna",
      "ru": "А что ты будешь делать вечером?",
      "fr": "Et qu'est-ce que tu vas faire ce soir ?"
    },
    {
      "speaker": "luka",
      "ru": "Я пойду в кино с М+ашей.",
      "fr": "Je vais aller au cinéma avec Macha."
    },
    {
      "speaker": "anna",
      "ru": "С Машей? Как интересно!",
      "fr": "Avec Macha ? C'est intéressant !"
    },
    {
      "speaker": "luka",
      "ru": "Мы просто друзья!",
      "fr": "On est juste amis !"
    }
  ],
