  "id": "15-invitation",
  "order": 15,
  "titleFr": "Une invitation",
  "titleRu": "Приглашение",
  "emoji": "🎭",
  "sceneFr": "Une semaine plus tard, Luka va mieux. Pour remercier Macha, il veut l'inviter au théâtre.",
  "dialogue": [
    {
      "speaker": "luka",
      "ru": "Маша, ты свободна в субботу?",
      "fr": "Macha, tu es libre samedi ?"
    },
    {
      "speaker": "masha",
      "ru": "Да, а что?",
      "fr": "Oui, pourquoi ?"
    },
    {
      "speaker": "luka",
      "ru": "Давай пойдём в театр!",
      "fr": "Allons au théâtre !"
    },
    {
      "speaker": "masha",
      "ru": "С удовольствием! А что там идёт?",
      "fr": "Avec plaisir ! Et qu'est-ce qui se joue ?"
    },
    {
      "speaker": "luka",
      "ru": "«Евгений Онегин». Это опера.",
      "fr": "« Eugène Onéguine ». C'est un opéra."
    },
    {
      "speaker": "masha",
      "ru": "Отлично! Во сколько?",
      "fr": "Parfait ! À quelle heure ?"
    },
    {
      "speaker": "luka",
      "ru": "В семь. Я куплю билеты.",
      "fr": "À sept heures. J'achèterai les billets."
    },
    {
      "speaker": "masha",
      "ru": "Спасибо, Л+ука! До субботы!",
      "fr": "Merci, Luka ! À samedi !"
    }
  ],
  "phrases": [
    {
      "id": "free",
      "speaker": "luka",
      "ru": "Маша, ты свободна в субботу?",
      "fr": "Macha, tu es libre samedi ?",
      "noteFr": "« Свободна » = libre (pour une femme). Pour un homme : « свободен ».",
      "gap": {
        "word": "свободна",
        "distractors": [
          "свободен",
          "театр"
        ],
        "whyFr": "Macha est une femme : « свободна » (-а). « Свободен », c'est pour un homme."
      },
      "orders": [
        "маша ты свободна в субботу",
        "маша в субботу ты свободна"
