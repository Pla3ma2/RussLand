  "sceneFr": "Quelques jours plus tard, Oleg croise Luka dans la rue et lui demande comment se passent ses journées.",
  "dialogue": [
    {
      "speaker": "oleg",
      "ru": "Привет, Л+ука! Что ты делаешь днём?",
      "fr": "Salut, Luka ! Qu'est-ce que tu fais dans la journée ?"
    },
    {
      "speaker": "luka",
      "ru": "Утром я учу русский.",
      "fr": "Le matin, j'apprends le russe."
    },
    {
      "speaker": "luka",
      "ru": "Днём я работаю.",
      "fr": "L'après-midi, je travaille."
    },
    {
      "speaker": "oleg",
      "ru": "А где ты работаешь?",
      "fr": "Et où est-ce que tu travailles ?"
    },
    {
      "speaker": "luka",
      "ru": "Я работаю в кафе. А ты?",
      "fr": "Je travaille dans un café. Et toi ?"
    },
    {
      "speaker": "oleg",
      "ru": "Я работаю в банке.",
      "fr": "Je travaille dans une banque."
    },
    {
      "speaker": "luka",
      "ru": "А что ты делаешь вечером?",
      "fr": "Et qu'est-ce que tu fais le soir ?"
    },
    {
      "speaker": "oleg",
      "ru": "Вечером я отдыхаю: читаю или смотрю фильмы.",
      "fr": "Le soir, je me repose : je lis ou je regarde des films."
    }
  ],
