  "sceneFr": "Anton, le frère de Macha, les invite à Moscou pour le Nouvel An. Luka va à la gare acheter les billets.",
  "dialogue": [
    {
      "speaker": "luka",
      "ru": "Здравствуйте! Два билета в Москву, пожалуйста.",
      "fr": "Bonjour ! Deux billets pour Moscou, s'il vous plaît."
    },
    {
      "speaker": "cashier",
      "ru": "На какое число?",
      "fr": "Pour quelle date ?"
    },
    {
      "speaker": "luka",
      "ru": "На тридцатое декабря.",
      "fr": "Pour le trente décembre."
    },
    {
      "speaker": "cashier",
      "ru": "Есть поезд в восемь утра.",
      "fr": "Il y a un train à huit heures du matin."
    },
    {
      "speaker": "luka",
      "ru": "Отлично. А сколько часов ехать?",
      "fr": "Parfait. Et combien d'heures de trajet ?"
    },
    {
      "speaker": "cashier",
      "ru": "Четыре часа.",
      "fr": "Quatre heures."
    },
    {
      "speaker": "luka",
      "ru": "Хорошо. Туда и обратно, пожалуйста.",
      "fr": "D'accord. Aller-retour, s'il vous plaît."
    },
    {
      "speaker": "cashier",
      "ru": "Вот ваши билеты. Счастливого пути!",
      "fr": "Voici vos billets. Bon voyage !"
    }
  ],
