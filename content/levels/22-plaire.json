  "emoji": "💛",
  "sceneFr": "Le 1er janvier, en se promenant dans Moscou, Anton demande à Luka ce qu'il pense de la ville.",
  "dialogue": [
    {
      "speaker": "anton",
      "ru": "Л+ука, тебе нравится Москва?",
      "fr": "Luka, Moscou te plaît ?"
    },
    {
      "speaker": "luka",
      "ru": "Да, очень нравится!",
      "fr": "Oui, beaucoup !"
    },
    {
      "speaker": "luka",
      "ru": "Мне нравится метро. Оно очень красивое.",
      "fr": "J'aime bien le métro. Il est très beau."
    },
    {
      "speaker": "anton",
      "ru": "А что тебе не нравится?",
      "fr": "Et qu'est-ce qui ne te plaît pas ?"
    },
    {
      "speaker": "luka",
      "ru": "Мне не нравится холод!",
      "fr": "Je n'aime pas le froid !"
    },
    {
      "speaker": "masha",
      "ru": "А мне нравится зима!",
      "fr": "Et moi, j'aime l'hiver !"
    },
    {
      "speaker": "anton",
      "ru": "Маша любит зиму, а я люблю лето.",
      "fr": "Macha aime l'hiver, et moi, j'aime l'été."
    },
    {
      "speaker": "luka",
      "ru": "Я тоже люблю лето!",
      "fr": "Moi aussi, j'aime l'été !"
    }
  ],
