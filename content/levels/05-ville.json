  "emoji": "🗺️",
  "sceneFr": "Luka se promène en ville quand son téléphone sonne : c'est Macha, sa voisine. Depuis leur rencontre, ils se tutoient.",
  "dialogue": [
    {
      "speaker": "masha",
      "ru": "Алло, Л+ука! Ты где?",
      "fr": "Allô, Luka ! Tu es où ?"
    },
    {
      "speaker": "luka",
      "ru": "Привет, М+аша! Я в парке.",
      "fr": "Salut, Macha ! Je suis au parc."
    },
    {
      "speaker": "masha",
      "ru": "А я в кафе. Это близко.",
      "fr": "Et moi, je suis au café. C'est tout près."
    },
    {
      "speaker": "luka",
      "ru": "Где кафе?",
      "fr": "Où est le café ?"
    },
    {
      "speaker": "masha",
      "ru": "Прямо, потом направо.",
      "fr": "Tout droit, puis à droite."
    },
    {
      "speaker": "luka",
      "ru": "Это далеко?",
      "fr": "C'est loin ?"
    },
    {
      "speaker": "masha",
      "ru": "Нет, пять минут.",
      "fr": "Non, cinq minutes."
    },
    {
      "speaker": "luka",
      "ru": "Хорошо, иду!",
      "fr": "D'accord, j'arrive !"
    }
  ],
