      ]
    },
    {
      "id": "fish",
      "speaker": "luka",
      "ru": "Да, дайте рыбу.",
      "fr": "Oui, donnez-moi du poisson.",
      "noteFr": "Après « дайте », c'est comme après « хочу » : « рыба » → « рыбу ».",
      "gap": {
        "word": "рыбу",
        "distractors": [
          "рыба",
          "стоит"
