    {
      "id": "price",
      "speaker": "luka",
      "ru": "Сколько стоит рыба?",
      "fr": "Combien coûte le poisson ?",
      "noteFr": "« Сколько стоит…? » = combien coûte… ? Ici, le poisson fait l'action (il coûte) : il garde sa forme de base, « рыба ».",
      "gap": {
        "word": "рыба",
        "distractors": [
