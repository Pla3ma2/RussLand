  "titleFr": "Au magasin",
  "titleRu": "В магазине",
  "emoji": "🛒",
  "sceneFr": "Avant de rejoindre Macha, Luka fait quelques courses dans la petite épicerie du quartier. Nina tient la caisse.",
  "dialogue": [
    {
      "speaker": "nina",
      "ru": "Здравствуйте! Я вас слушаю.",
      "fr": "Bonjour ! Je vous écoute."
    },
    {
      "speaker": "luka",
      "ru": "Здравствуйте! У вас есть хлеб?",
      "fr": "Bonjour ! Vous avez du pain ?"
    },
    {
      "speaker": "nina",
      "ru": "Да, есть.",
      "fr": "Oui, il y en a."
    },
    {
      "speaker": "luka",
      "ru": "Дайте, пожалуйста, хлеб и молоко.",
      "fr": "Donnez-moi du pain et du lait, s'il vous plaît."
    },
    {
      "speaker": "nina",
      "ru": "Что-нибудь ещё?",
      "fr": "Autre chose ?"
    },
    {
      "speaker": "luka",
      "ru": "Да, дайте рыбу. Сколько стоит рыба?",
      "fr": "Oui, donnez-moi du poisson. Combien coûte le poisson ?"
    },
    {
      "speaker": "nina",
      "ru": "Триста рублей.",
      "fr": "Trois cents roubles."
    },
    {
      "speaker": "luka",
      "ru": "Хорошо. Вот, пожалуйста.",
      "fr": "D'accord. Voilà."
    },
    {
      "speaker": "nina",
      "ru": "Спасибо! До свидания!",
      "fr": "Merci ! Au revoir !"
    },
    {
      "speaker": "luka",
      "ru": "До свидания!",
      "fr": "Au revoir !"
    }
  ],
  "phrases": [
