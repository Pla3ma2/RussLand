  "id": "16-hiver",
  "order": 16,
  "titleFr": "L'hiver arrive",
  "titleRu": "Зима",
  "emoji": "❄️",
  "sceneFr": "Novembre à Saint-Pétersbourg. En sortant du théâtre, Luka découvre la neige… et le froid russe.",
  "dialogue": [
    {
      "speaker": "luka",
      "ru": "Ой, как холодно!",
      "fr": "Oh, qu'il fait froid !"
    },
    {
      "speaker": "masha",
      "ru": "Да, сегодня минус десять.",
      "fr": "Oui, aujourd'hui il fait moins dix."
    },
    {
      "speaker": "luka",
      "ru": "Минус десять? А во Франции сейчас тепло.",
      "fr": "Moins dix ? Et en France, en ce moment, il fait doux."
    },
    {
      "speaker": "masha",
      "ru": "Где твоя шапка?",
      "fr": "Où est ton bonnet ?"
    },
    {
      "speaker": "luka",
      "ru": "У меня нет шапки.",
      "fr": "Je n'ai pas de bonnet."
    },
    {
      "speaker": "masha",
      "ru": "Завтра надо купить шапку!",
      "fr": "Demain, il faut acheter un bonnet !"
    },
    {
      "speaker": "luka",
      "ru": "Хорошо. А ты любишь зиму?",
      "fr": "D'accord. Et toi, tu aimes l'hiver ?"
    },
    {
      "speaker": "masha",
      "ru": "Очень люблю! Зимой красиво.",
      "fr": "J'adore ! En hiver, c'est beau."
    }
  ],
  "phrases": [
    {
      "id": "cold",
      "speaker": "luka",
      "ru": "Ой, как холодно!",
      "fr": "Oh, qu'il fait froid !",
      "noteFr": "« Холодно » = il fait froid. Pas de « il fait » en russe : un seul mot suffit !",
      "gap": {
        "word": "холодно",
        "distractors": [
          "тепло",
          "шапка"
        ],
        "whyFr": "Il fait froid : « холодно ». « Тепло » veut dire « il fait doux »."
      }
    },
    {
      "id": "minus",
      "speaker": "masha",
      "ru": "Да, сегодня минус десять.",
      "fr": "Oui, aujourd'hui il fait moins dix.",
      "noteFr": "« Минус десять » = moins dix. « Сегодня » = aujourd'hui.",
      "gap": {
        "word": "десять",
        "distractors": [
          "шапку",
          "зиму"
        ]
      }
    },
    {
      "id": "warm",
      "speaker": "luka",
      "ru": "А во Франции сейчас тепло.",
      "fr": "Et en France, en ce moment, il fait doux.",
      "noteFr": "« Во Франции » = en France (« во » devant certains sons, pour que ce soit plus facile à dire). « Тепло » = il fait doux, chaud.",
      "gap": {
        "word": "франции",
        "distractors": [
          "франция",
          "шапки"
        ],
        "whyFr": "Pour dire où : « во Франции ». Tu connais « из Франции » depuis la première leçon !"
      },
      "orders": [
        "а во франции сейчас тепло",
        "а сейчас во франции тепло"
      ]
    },
    {
      "id": "hat",
      "speaker": "masha",
      "ru": "Где твоя шапка?",
      "fr": "Où est ton bonnet ?",
      "noteFr": "« Твоя » = ta (« твой » = ton). « Шапка » = bonnet.",
      "gap": {
        "word": "твоя",
        "distractors": [
          "твой",
          "моя"
        ],
        "whyFr": "« Шапка » est féminin (-а) : « твоя ». « Твой », c'est pour un mot masculin."
      },
      "orders": [
        "где твоя шапка"
      ]
    },
    {
      "id": "nohat",
      "speaker": "luka",
      "ru": "У меня нет шапки.",
      "fr": "Je n'ai pas de bonnet.",
      "noteFr": "« У меня нет… » = je n'ai pas de… Le mot change : « шапка » → « нет шапки ». Retiens-le pour l'instant.",
      "gap": {
        "word": "нет",
        "distractors": [
          "есть",
          "надо"
        ],
        "whyFr": "« У меня нет » = je n'ai pas. « У меня есть », ce serait « j'ai »."
      }
    },
    {
      "id": "buy",
      "speaker": "masha",
      "ru": "Завтра надо купить шапку!",
      "fr": "Demain, il faut acheter un bonnet !",
      "noteFr": "« Надо » = il faut. « Купить » = acheter. Le bonnet est ce qu'on achète : « шапку » (-у).",
      "gap": {
        "word": "шапку",
        "distractors": [
          "шапка",
          "шапки"
        ],
        "whyFr": "On achète le bonnet : c'est le bleu, « шапку » (-у), comme après « хочу »."
      },
      "orders": [
