  "sceneFr": "Anton fait visiter son appartement à Luka et Macha.",
  "dialogue": [
    {
      "speaker": "anton",
      "ru": "Вот моя квартира. Проходите!",
      "fr": "Voici mon appartement. Entrez !"
    },
    {
      "speaker": "luka",
      "ru": "Какая большая квартира!",
      "fr": "Quel grand appartement !"
    },
    {
      "speaker": "anton",
      "ru": "Это моя комната, а это кухня.",
      "fr": "Ça, c'est ma chambre, et ça, c'est la cuisine."
    },
    {
      "speaker": "luka",
      "ru": "А где туалет?",
      "fr": "Et où sont les toilettes ?"
    },
    {
      "speaker": "anton",
      "ru": "Туалет там, направо.",
      "fr": "Les toilettes sont là-bas, à droite."
    },
    {
      "speaker": "masha",
      "ru": "А где Л+ука будет спать?",
      "fr": "Et où va dormir Luka ?"
    },
    {
      "speaker": "anton",
      "ru": "Здесь, на диване.",
      "fr": "Ici, sur le canapé."
    },
    {
      "speaker": "masha",
      "ru": "Отлично! А ужинать мы будем на кухне.",
      "fr": "Parfait ! Et on va dîner dans la cuisine."
    }
  ],
