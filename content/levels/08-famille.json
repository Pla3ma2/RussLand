  "emoji": "👨‍👩‍👧",
  "sceneFr": "Au dîner, Macha demande à Luka s'il a de la famille en France. Luka sort son téléphone pour montrer des photos.",
  "dialogue": [
    {
      "speaker": "masha",
      "ru": "Л+ука, у тебя есть брат или сестра?",
      "fr": "Luka, tu as un frère ou une sœur ?"
    },
    {
      "speaker": "luka",
      "ru": "Да, у меня есть сестра.",
      "fr": "Oui, j'ai une sœur."
    },
    {
      "speaker": "luka",
      "ru": "Вот фото. Это моя сестра. Её зовут Ж+юли.",
      "fr": "Voici une photo. C'est ma sœur. Elle s'appelle Julie."
    },
    {
      "speaker": "masha",
      "ru": "Какая красивая! А это кто?",
      "fr": "Qu'elle est belle ! Et ça, c'est qui ?"
    },
    {
      "speaker": "luka",
      "ru": "Это мой папа, а это моя мама.",
      "fr": "C'est mon père, et ça, c'est ma mère."
    },
    {
      "speaker": "masha",
      "ru": "А у меня есть брат. Он живёт в Москве.",
      "fr": "Et moi, j'ai un frère. Il habite à Moscou."
    },
    {
      "speaker": "luka",
      "ru": "Как его зовут?",
      "fr": "Comment il s'appelle ?"
    },
    {
      "speaker": "masha",
      "ru": "Его зовут Ант+он.",
      "fr": "Il s'appelle Anton."
    }
  ],
  "phrases": [
    {
      "id": "haveq",
      "speaker": "masha",
      "ru": "У тебя есть брат или сестра?",
      "fr": "Tu as un frère ou une sœur ?",
      "noteFr": "« У тебя есть…? » = « tu as… ? » (mot à mot : « chez toi, il y a… ? »). « Или » = ou.",
      "gap": {
        "word": "или",
        "distractors": [
          "тоже",
          "вот"
        ]
      },
      "orders": [
        "у тебя есть брат или сестра",
        "у тебя есть сестра или брат"
      ]
    },
    {
      "id": "havesis",
      "speaker": "luka",
      "ru": "Да, у меня есть сестра.",
      "fr": "Oui, j'ai une sœur.",
      "noteFr": "« У меня есть » = « j'ai ». Pas de verbe « avoir » : on dit « chez moi, il y a ».",
      "gap": {
        "word": "меня",
        "distractors": [
          "тебя",
          "мой"
        ],
        "whyFr": "« У меня » = chez moi → j'ai. « У тебя », c'est « tu as »."
      },
      "orders": [
        "да у меня есть сестра"
      ]
    },
    {
      "id": "mysis",
      "speaker": "luka",
      "ru": "Это моя сестра.",
      "fr": "C'est ma sœur.",
      "noteFr": "« Сестра » est féminin (-а), donc « моя ».",
      "gap": {
        "word": "моя",
        "distractors": [
          "мой",
          "кто"
        ],
        "whyFr": "« Сестра » finit par -а : c'est féminin, donc « моя » (ma)."
      }
    },
    {
      "id": "hername",
      "speaker": "luka",
      "ru": "Её зовут Ж+юли.",
      "fr": "Elle s'appelle Julie.",
      "noteFr": "Comme « меня зовут », avec « её » (elle) : « on l'appelle Julie ».",
      "gap": {
        "word": "её",
        "distractors": [
          "его",
          "вот"
        ],
        "whyFr": "Pour une femme : « её зовут ». « Его », c'est pour un homme."
      }
    },
    {
      "id": "who",
      "speaker": "masha",
      "ru": "А это кто?",
      "fr": "Et ça, c'est qui ?",
      "noteFr": "« Кто » = qui.",
      "gap": {
        "word": "кто",
        "distractors": [
