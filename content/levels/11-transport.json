  "emoji": "🚇",
  "sceneFr": "Lundi matin, Luka part à son cours de russe. Dans l'ascenseur, il retrouve Macha qui va à l'hôpital.",
  "dialogue": [
    {
      "speaker": "masha",
      "ru": "Доброе утро, Л+ука! Куда ты идёшь?",
      "fr": "Bonjour, Luka ! Où est-ce que tu vas ?"
    },
    {
      "speaker": "luka",
      "ru": "Доброе утро! Я иду на урок.",
      "fr": "Bonjour ! Je vais à mon cours."
    },
    {
      "speaker": "masha",
      "ru": "Ты едешь на метро?",
      "fr": "Tu y vas en métro ?"
    },
    {
      "speaker": "luka",
      "ru": "Нет, я еду на автобусе. А ты?",
      "fr": "Non, j'y vais en bus. Et toi ?"
    },
    {
      "speaker": "masha",
      "ru": "Я еду в больницу. На метро.",
      "fr": "Je vais à l'hôpital. En métro."
    },
    {
      "speaker": "luka",
      "ru": "Это далеко?",
      "fr": "C'est loin ?"
    },
    {
      "speaker": "masha",
      "ru": "Нет, двадцать минут. Пока!",
      "fr": "Non, vingt minutes. Salut !"
    },
    {
      "speaker": "luka",
      "ru": "Пока! Хорошего дня!",
      "fr": "Salut ! Bonne journée !"
    }
  ],
