  "emoji": "🧳",
  "sceneFr": "De retour à Saint-Pétersbourg, Luka retrouve Oleg et lui raconte son voyage à Moscou.",
  "dialogue": [
    {
      "speaker": "oleg",
      "ru": "Привет, Л+ука! Ну, как Москва?",
      "fr": "Salut, Luka ! Alors, comment c'était Moscou ?"
    },
    {
      "speaker": "luka",
      "ru": "Привет! Было очень интересно!",
      "fr": "Salut ! C'était très intéressant !"
    },
    {
      "speaker": "oleg",
      "ru": "Что вы делали?",
      "fr": "Qu'est-ce que vous avez fait ?"
    },
    {
      "speaker": "luka",
      "ru": "Мы гуляли в центре и смотрели Кремль.",
      "fr": "On s'est promenés dans le centre et on a regardé le Kremlin."
    },
    {
      "speaker": "luka",
      "ru": "А Новый год мы встречали у Антона.",
      "fr": "Et on a fêté le Nouvel An chez Anton."
    },
    {
      "speaker": "oleg",
      "ru": "А что ещё?",
      "fr": "Et quoi d'autre ?"
    },
    {
      "speaker": "luka",
      "ru": "Мы были на катке. Я катался, но плохо!",
      "fr": "On est allés à la patinoire. J'ai patiné, mais mal !"
    },
    {
      "speaker": "oleg",
      "ru": "Молодец! Тебе понравилась Москва?",
      "fr": "Bravo ! Moscou t'a plu ?"
    },
    {
      "speaker": "luka",
      "ru": "Очень понравилась! Но Петербург я люблю больше.",
      "fr": "Beaucoup ! Mais je préfère Saint-Pétersbourg."
    }
  ],
