  "sceneFr": "Le lendemain du foot, Luka ne se sent pas bien. Il frappe chez sa voisine Macha… qui est médecin !",
  "dialogue": [
    {
      "speaker": "masha",
      "ru": "Л+ука? Что случилось?",
      "fr": "Luka ? Qu'est-ce qui s'est passé ?"
    },
    {
      "speaker": "luka",
      "ru": "Маша, мне плохо.",
      "fr": "Macha, je ne me sens pas bien."
    },
    {
      "speaker": "masha",
      "ru": "Что у тебя болит?",
      "fr": "Où est-ce que tu as mal ?"
    },
    {
      "speaker": "luka",
      "ru": "У меня болит голова. И горло тоже.",
      "fr": "J'ai mal à la tête. Et à la gorge aussi."
    },
    {
      "speaker": "masha",
      "ru": "У тебя есть температура?",
      "fr": "Tu as de la fièvre ?"
    },
    {
      "speaker": "luka",
      "ru": "Да, тридцать восемь.",
      "fr": "Oui, trente-huit."
    },
    {
      "speaker": "masha",
      "ru": "Это грипп. Пей чай и отдыхай.",
      "fr": "C'est la grippe. Bois du thé et repose-toi."
    },
    {
      "speaker": "luka",
      "ru": "Спасибо, доктор!",
      "fr": "Merci, docteur !"
    }
  ],
