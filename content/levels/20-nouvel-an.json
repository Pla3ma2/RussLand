  "sceneFr": "Le 31 décembre, chez Anton. Il est presque minuit : tout le monde prépare la fête.",
  "dialogue": [
    {
      "speaker": "anton",
      "ru": "Скоро Новый год! Что ты хочешь на Новый год, Л+ука?",
      "fr": "Bientôt le Nouvel An ! Qu'est-ce que tu veux pour le Nouvel An, Luka ?"
    },
    {
      "speaker": "luka",
      "ru": "Я хочу хорошо говорить по-русски!",
      "fr": "Je veux bien parler russe !"
    },
    {
      "speaker": "masha",
      "ru": "Ты уже хорошо говоришь!",
      "fr": "Tu parles déjà bien !"
    },
    {
      "speaker": "anton",
      "ru": "Двенадцать часов! С Новым годом!",
      "fr": "Minuit ! Bonne année !"
    },
    {
      "speaker": "luka",
      "ru": "С Новым годом! С новым счастьем!",
      "fr": "Bonne année ! Plein de bonheur !"
    },
    {
      "speaker": "masha",
      "ru": "Давайте пить шампанское!",
      "fr": "Buvons du champagne !"
    },
    {
      "speaker": "anton",
      "ru": "За нас! За дружбу!",
      "fr": "À nous ! À l'amitié !"
    },
    {
      "speaker": "luka",
      "ru": "За дружбу!",
      "fr": "À l'amitié !"
    }
  ],
