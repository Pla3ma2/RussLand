  "titleFr": "Chez des amis",
  "titleRu": "В гостях",
  "emoji": "🍽️",
  "sceneFr": "Le soir, Macha invite Luka à dîner. Son ami Oleg est là aussi… et Luka a l'impression de l'avoir déjà vu quelque part.",
  "dialogue": [
    {
      "speaker": "masha",
      "ru": "Л+ука, это мой друг Ол+ег.",
      "fr": "Luka, voici mon ami Oleg."
    },
    {
      "speaker": "oleg",
      "ru": "Привет! Мы знакомы! Банк, да?",
      "fr": "Salut ! On se connaît ! La banque, c'est ça ?"
    },
    {
      "speaker": "luka",
      "ru": "Да! Очень приятно, Ол+ег.",
      "fr": "Oui ! Enchanté, Oleg."
    },
    {
      "speaker": "oleg",
      "ru": "Где ты живёшь, Л+ука?",
      "fr": "Où est-ce que tu habites, Luka ?"
    },
    {
      "speaker": "luka",
      "ru": "Сейчас я живу в Петерб+урге. А дома я живу в Ли+оне.",
      "fr": "En ce moment, j'habite à Saint-Pétersbourg. Mais chez moi, j'habite à Lyon."
    },
    {
      "speaker": "oleg",
      "ru": "Как интересно! Что ты любишь?",
      "fr": "Comme c'est intéressant ! Qu'est-ce que tu aimes ?"
    },
    {
      "speaker": "luka",
      "ru": "Я люблю музыку и кино.",
      "fr": "J'aime la musique et le cinéma."
    },
    {
      "speaker": "masha",
      "ru": "А я люблю книги.",
      "fr": "Et moi, j'aime les livres."
    },
    {
      "speaker": "oleg",
      "ru": "Давайте ужинать!",
      "fr": "À table !"
    }
  ],
