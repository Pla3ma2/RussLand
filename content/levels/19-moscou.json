  "emoji": "🏰",
  "sceneFr": "Le 30 décembre, Luka et Macha arrivent à Moscou. Anton, le frère de Macha, les attend à la gare.",
  "dialogue": [
    {
      "speaker": "anton",
      "ru": "Маша! Привет! Как доехали?",
      "fr": "Macha ! Salut ! Le voyage s'est bien passé ?"
    },
    {
      "speaker": "masha",
      "ru": "Хорошо! Антон, это Л+ука, мой друг.",
      "fr": "Bien ! Anton, voici Luka, mon ami."
    },
    {
      "speaker": "anton",
      "ru": "Очень приятно, Л+ука! Добро пожаловать в Москву!",
      "fr": "Enchanté, Luka ! Bienvenue à Moscou !"
    },
    {
      "speaker": "luka",
      "ru": "Спасибо! Москва — очень большой город.",
      "fr": "Merci ! Moscou, c'est une très grande ville."
    },
    {
      "speaker": "anton",
      "ru": "Да, и очень красивый. Это Красная площадь.",
      "fr": "Oui, et très belle. Voici la place Rouge."
    },
    {
      "speaker": "luka",
      "ru": "Какая большая площадь!",
      "fr": "Quelle grande place !"
    },
    {
      "speaker": "anton",
      "ru": "А это Кремль. Он очень старый.",
      "fr": "Et ça, c'est le Kremlin. Il est très vieux."
    },
    {
      "speaker": "luka",
      "ru": "Как интересно! Я хочу всё посмотреть!",
      "fr": "Comme c'est intéressant ! Je veux tout voir !"
    }
  ],
