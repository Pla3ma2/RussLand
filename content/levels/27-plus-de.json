  "titleFr": "Il n'y a plus de pain !",
  "titleRu": "Нет хлеба!",
  "emoji": "🥖",
  "sceneFr": "Pendant la fête, Luka ouvre le frigo… il manque des choses ! Oleg propose d'aller au magasin.",
  "dialogue": [
    {
      "speaker": "luka",
      "ru": "Ой! У нас нет хлеба!",
      "fr": "Oh ! On n'a plus de pain !"
    },
    {
      "speaker": "oleg",
      "ru": "И сока тоже нет.",
      "fr": "Et il n'y a plus de jus non plus."
    },
    {
      "speaker": "luka",
      "ru": "А вода есть?",
      "fr": "Et de l'eau, il y en a ?"
    },
    {
      "speaker": "oleg",
      "ru": "Нет, воды тоже нет!",
      "fr": "Non, plus d'eau non plus !"
    },
    {
      "speaker": "luka",
      "ru": "Где здесь магазин?",
      "fr": "Où est le magasin, par ici ?"
    },
    {
      "speaker": "oleg",
      "ru": "Рядом, две минуты. Я пойду.",
      "fr": "Tout près, deux minutes. J'y vais."
    },
    {
      "speaker": "luka",
      "ru": "Спасибо! Купи хлеб, сок и воду.",
      "fr": "Merci ! Achète du pain, du jus et de l'eau."
    },
    {
      "speaker": "oleg",
      "ru": "Хорошо. Что-нибудь ещё?",
      "fr": "D'accord. Autre chose ?"
    }
  ],
  "phrases": [
