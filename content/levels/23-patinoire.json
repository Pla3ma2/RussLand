  "insights": [
    {
      "by": "anton",
      "fr": [
        "« Мочь » = pouvoir : я могу, ты можешь, он может, мы можем, вы можете, они могут.",
        "Comme « хочу », on ajoute un verbe à l'infinitif : « я могу помочь », « ты можешь говорить медленнее ? »."
      ]
    },
    {
      "by": "anton",
      "fr": [
        "Attention : « уметь » = savoir faire (une compétence) : « я умею кататься », « я не умею плавать ».",
        "« Мочь » = pouvoir (c'est possible, j'ai le temps, j'ai le droit) : « я не могу, я работаю »."
      ]
    }
  ],
