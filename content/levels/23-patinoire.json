  "sceneFr": "Le 2 janvier, Anton emmène Luka et Macha à la patinoire. Luka n'a jamais patiné…",
  "dialogue": [
    {
      "speaker": "anton",
      "ru": "Пойдём на каток!",
      "fr": "Allons à la patinoire !"
    },
    {
      "speaker": "luka",
      "ru": "Но я не умею кататься на коньках.",
      "fr": "Mais je ne sais pas patiner."
    },
    {
      "speaker": "anton",
      "ru": "Ничего, я могу помочь.",
      "fr": "Pas grave, je peux t'aider."
    },
    {
      "speaker": "masha",
      "ru": "Это просто! Смотри!",
      "fr": "C'est facile ! Regarde !"
    },
    {
      "speaker": "luka",
      "ru": "Антон, ты можешь мне помочь?",
      "fr": "Anton, tu peux m'aider ?"
    },
    {
      "speaker": "anton",
      "ru": "Конечно! Дай руку.",
      "fr": "Bien sûr ! Donne-moi la main."
    },
    {
      "speaker": "luka",
      "ru": "Ой! Я упал!",
      "fr": "Aïe ! Je suis tombé !"
    },
    {
      "speaker": "masha",
      "ru": "Ничего! Ещё раз!",
      "fr": "Pas grave ! Encore une fois !"
    }
  ],
